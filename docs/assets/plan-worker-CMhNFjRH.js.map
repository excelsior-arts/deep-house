      { "id": "dub", "level": 0, "effect": "tapeDelay", "params": { "timeBeats": 1.5, "feedback": 0.55, "highpassHz": 450, "lowpassHz": 2000, "wow": 0.4, "pingPong": 1, "mix": 1 } }
     ]
