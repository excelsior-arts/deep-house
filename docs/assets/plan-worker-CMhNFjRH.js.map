{
  "schema": 1,
  "kind": "space",
  "id": "widePlateDrift",
  "revision": 2,
  "name": "Wide plate, slow drift",
  "says": "The image opened a third wider and drifting slowly, into a 4.5 s plate cut under 350 Hz: wide and airy, no repeats.",
