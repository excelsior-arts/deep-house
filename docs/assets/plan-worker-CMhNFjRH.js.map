  "provenance": {
    "round": "sounds-r2",
    "module": "supersaw-pad.ts",
    "note": "A supersaw pad: seven saws spread across a fifth of a semitone and across the stereo picture, under a lowpass that opens over the first seconds of the note. It is the widest and the most expensive voice in the engine, and it is the sustained role's second family: `strings` is an ensemble of five with a chorus on it, this is one instrument with seven oscillators in it.",
    "notes": {
      "detuneCents": "The spread of the stack, end to end. A supersaw's whole character is that the detune is *even* across the voices and wide enough that the beats are a texture rather than a wobble.",
      "cutoff": "The slow sweep. It opens from `cutoff` to `sweepTo` over `sweepTime`, which is seconds and not milliseconds: on a pad this is the arrangement and not the attack.",
      "driftHz": "The stack drifts: the outer voices wander a few cents at a fourteenth of a Hertz, so the width breathes instead of standing still."
    }
  }
