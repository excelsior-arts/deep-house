{
  "name": "@deep-house/app",
  "version": "2.5.0",
  "description": "Deep House — the composer and the page: the dice, the corpus, the style, the sound stage, the set and the ring.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE",
  "dependencies": {
    "@deep-house/engine": "1.0.0",
    "@sentry/browser": "^11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "dev": "VITE_PRIVATE_TOOLS=1 vite",
    "build": "vite build",
    "build:preview": "VITE_PRIVATE_TOOLS=1 vite build",
    "preview": "vite preview",
    "check": "node tools/check-all.ts",
    "guards": "node tools/check-program-guards.ts",
    "lengths": "node tools/length-table.ts",
    "test": "node tools/test.ts --build",
    "test:browsers": "vite build && node tools/test-browsers.ts",
    "bless": "node tools/bless.ts",
    "imprint:golden": "node tools/imprint/imprint-golden.ts",
    "review": "node tools/review/server.ts"
  }
}
